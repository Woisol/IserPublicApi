SERVER_PORT=3000
BASE_URL=http://localhost:3000

AUTHORITY_API_KEY=

# 支持：
# - wxwork(企业微信)
# - qqbot(QQ 官方机器人)
WEBHOOK_SEND_ADAPTER=qqbot

# QQ 官方机器人配置（启用 WEBHOOK_SEND_ADAPTER=qqbot 时必填）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_COMMAND_PREFIX=/

QQBOT_COMMAND_WHITE_LIST=

# 内部已经内置，也可以在这里手动覆盖
# WXWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send

# https://jingweidu.bmcx.com/ ，最多两位小数
QWEATHER_LOCATION=
QWEATHER_API_KEY=
QWEATHER_API_HOST=

GAMELOG_BASEURL=
GAMELOG_GENSHINLOGSURL=path/to/BetterGI/log
GAMELOG_STARRAILLOGSURL=path/to/March7thAssistant_full/logs/